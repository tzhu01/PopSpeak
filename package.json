{
  "name": "popspeak",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "description": "Open-source, offline-first voice input assistant for Windows",
  "keywords": [
    "speech-to-text",
    "stt",
    "llm",
    "tauri",
    "desktop",
    "voice-input"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tzhu01/PopSpeak"
  },
  "homepage": "https://tzhu01.github.io/PopSpeak/",
  "bugs": {
    "url": "https://github.com/tzhu01/PopSpeak/issues"
  },
  "author": "PopSpeak Contributors",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "audit:source-release": "pwsh -NoProfile -File ./scripts/audit-source-release.ps1",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3",
    "@tauri-apps/plugin-deep-link": "^2.4",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-global-shortcut": "^2.3",
    "@tauri-apps/plugin-opener": "^2.5",
    "@tauri-apps/plugin-sql": "^2.4",
    "@tauri-apps/plugin-store": "^2.4",
    "better-auth": "^1.7.5",
    "framer-motion": "^13.4",
    "i18next": "^26.4",
    "lucide-react": "^1.47",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0",
    "zustand": "^5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0",
    "@tailwindcss/vite": "^4.3",
    "@tauri-apps/cli": "^2.11",
    "@testing-library/jest-dom": "^7.0",
    "@testing-library/react": "^16.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.18",
    "eslint-plugin-react-hooks": "^5.2",
    "eslint-plugin-react-refresh": "^0.4",
    "jsdom": "^30.1",
    "prettier": "^3.5",
    "tailwindcss": "^4.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  }
}
