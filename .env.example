# Public build-time settings only. Values prefixed with VITE_ are embedded in
# the frontend bundle and MUST NOT contain API keys, tokens, private URLs or
# signing material.

# Optional PopSpeak account/cloud backend. Leave blank for the local-only app.
VITE_API_BASE_URL=

# Optional public-account activation entry shown in the UI.
VITE_PUBLIC_ACCOUNT_NAME=
VITE_PUBLIC_ACCOUNT_URL=
VITE_PUBLIC_ACCOUNT_QR_URL=

# Native backend override for development. This is not a secret store.
API_BASE_URL=
